include README.md
include LICENSE

include requirements.txt
recursive-include src/ambr *.py

prune .claude
prune .github
prune benchmarks
prune docs
prune examples
prune paper
prune tests
exclude paper.zip
global-exclude *.aux *.bbl *.blg *.log *.out *.toc *.synctex.gz
global-exclude __pycache__ *.py[cod] .DS_Store .coverage .coverage.* .!*.coverage
