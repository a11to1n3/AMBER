#!/usr/bin/env python3
"""Regenerate all paper figures (plot01--plot21) with unified AAMAS style."""
from __future__ import annotations

import json
import math
import shutil
import sys
from pathlib import Path

import matplotlib.pyplot as plt
import numpy as np
from matplotlib.patches import FancyArrowPatch, FancyBboxPatch, Patch
from PIL import Image

SCRIPT_DIR = Path(__file__).resolve().parent
ROOT = SCRIPT_DIR.parent
FIGS = ROOT / "figs"
DATA = ROOT / "artifacts"

sys.path.insert(0, str(SCRIPT_DIR))
from amber_figure_style import (  # noqa: E402
    CERT,
    COL_W,
    COND,
    DPI,
    FRAMEWORK_COLORS,
    FREE,
    FULL_W,
    MUTED,
    PANEL_H,
    SAFE,
    SEQ,
    apply_figure_style,
    panel_label,
    save_figure,
    style_axes,
)

FIGS.mkdir(parents=True, exist_ok=True)


def _load(name: str):
    return json.loads((DATA / name).read_text())


def _critical_tau(attack, taus, thresh=0.5):
    a = np.asarray(attack, float)
    t = np.asarray(taus, float)
    for j in range(1, len(a)):
        if a[j - 1] < thresh <= a[j]:
            f = (thresh - a[j - 1]) / (a[j] - a[j - 1] + 1e-12)
            return float(t[j - 1] + f * (t[j] - t[j - 1]))
    return float("nan")


# ------------------------------------------------------------------ plot01
def build_plot01():
    """Render the two execution paths without implying shared certification."""
    apply_figure_style()
    fig, ax = plt.subplots(figsize=(FULL_W, 3.7))
    fig.subplots_adjust(left=0.02, right=0.98, top=0.97, bottom=0.04)
    ax.set_xlim(0, 10)
    ax.set_ylim(0, 6)
    ax.axis("off")

    def box(x, y, w, h, title, body, edge, face):
        patch = FancyBboxPatch(
            (x, y), w, h,
            boxstyle="round,pad=0.08,rounding_size=0.10",
            linewidth=1.25, edgecolor=edge, facecolor=face,
        )
        ax.add_patch(patch)
        ax.text(x + w / 2, y + h - 0.30, title, ha="center", va="top",
                fontsize=10, fontweight="bold", color=edge)
        ax.text(x + 0.22, y + h - 0.72, body, ha="left", va="top",
                fontsize=8.1, color="#1f2937", linespacing=1.35)
        return patch

    box(
        2.35, 4.85, 5.30, 0.90,
        "ONE PUBLIC MODEL / RUN API",
        "Choose cpu(mode=\"oop\"), cpu(mode=\"vectorized\"), or gpu()",
        "#334155", "#f8fafc",
    )

    box(
        0.35, 2.40, 4.25, 2.05,
        "INSTRUMENTED GENERAL PATH",
        "Observed OOP, column, and device operations\n"
        "Runtime report: duplicate writes, commit-before-\n"
        "borrow, schema/id changes, mutable-array warning\n"
        "Clean means: no monitored violation was observed",
        "#0f766e", "#ecfdf5",
    )
    box(
        5.40, 2.40, 4.25, 2.05,
        "OPTIMIZED GPU BENCHMARK PATH",
        "Private model-specific CuPy/CUDA loops\n"
        "Contract and reporters disabled for timing\n"
        "10M-agent benchmark across four workloads\n"
        "Checked separately against model references",
        "#6d28d9", "#f5f3ff",
    )

    for x0, x1 in ((4.25, 2.48), (5.75, 7.52)):
        ax.add_patch(FancyArrowPatch(
            (x0, 4.83), (x1, 4.48), arrowstyle="-|>", mutation_scale=12,
            linewidth=1.25, color="#64748b",
        ))

    box(
        1.20, 0.35, 7.60, 1.20,
        "CLAIM BOUNDARY",
        "The non-interference theorem is a sufficient semantic result.  The runtime report is an\n"
        "operational diagnostic.  It does not certify the private fast loop or arbitrary array code.",
        "#b45309", "#fffbeb",
    )
    for x in (2.48, 7.52):
        ax.add_patch(FancyArrowPatch(
            (x, 2.38), (5.0, 1.57), arrowstyle="-|>", mutation_scale=11,
            linewidth=1.1, color="#94a3b8",
        ))

    save_figure(fig, FIGS / "plot01.png")


# ------------------------------------------------------------------ plot02
def build_plot02():
    apply_figure_style()
    SAFE_BG, COND_BG, UNSAFE_BG = "#e3f0e8", "#f8efd8", "#f9e4e1"
    NODE, NODE_BG = "#2f4254", "#e8ecf1"
    fig, ax = plt.subplots(figsize=(COL_W, COL_W * 1.15))
    ax.set_xlim(0, 10)
    ax.set_ylim(0, 10)
    ax.axis("off")

    def box(x, y, w, h, txt, ec, fc, fs=9.5, bold=False):
        ax.add_patch(
            FancyBboxPatch(
                (x - w / 2, y - h / 2),
                w,
                h,
                boxstyle="round,pad=0.03,rounding_size=0.10",
                ec=ec,
                fc=fc,
                lw=1.5,
                zorder=2,
            )
        )
        ax.text(
            x,
            y,
            txt,
            ha="center",
            va="center",
            fontsize=fs,
            color="#141414",
            fontweight="bold" if bold else "normal",
            zorder=3,
            linespacing=1.35,
        )

    def arrow(x1, y1, x2, y2, label=None, lx=0, ly=0, col=NODE, fs=9):
        ax.add_patch(
            FancyArrowPatch(
                (x1, y1),
                (x2, y2),
                arrowstyle="-|>",
                mutation_scale=13,
                lw=1.5,
                color=col,
                zorder=1,
                shrinkA=2,
                shrinkB=2,
            )
        )
        if label:
            ax.text(
                (x1 + x2) / 2 + lx,
                (y1 + y2) / 2 + ly,
                label,
                ha="center",
                va="center",
                fontsize=fs,
                color=col,
                fontstyle="italic",
                zorder=5,
                bbox=dict(boxstyle="round,pad=0.15", fc="white", ec=col, lw=0.6),
            )

    box(5.0, 9.4, 3.8, 0.85, "Agent update rule\n(one step, $N$ agents)", NODE, NODE_BG, fs=10, bold=True)
    box(5.0, 8.05, 4.1, 0.9, "Reads & writes\nonly its own row?", NODE, "#ffffff", fs=10, bold=True)
    arrow(5.0, 8.97, 5.0, 8.52)
    box(1.85, 6.35, 3.15, 1.55, "P — pointwise\nsatisfies condition", SAFE, SAFE_BG, fs=9.5)
    arrow(3.0, 7.62, 2.15, 7.16, "yes", lx=-0.25, ly=0.05, col=SAFE)
    box(6.65, 6.6, 4.35, 1.0, "Write target =\nmany → one cell?", NODE, "#ffffff", fs=10, bold=True)
    arrow(6.05, 7.62, 6.65, 7.13, "no", lx=1.05, fs=9)
    box(8.2, 4.5, 3.0, 0.95, "AC reducer + fixed\ncontributions?", NODE, "#ffffff", fs=9.5, bold=True)
    arrow(7.5, 6.08, 8.2, 5.0, "yes", lx=0.4, ly=0.08)
    box(8.15, 2.75, 3.4, 1.55, "R — commutative\nreduction\nsatisfies condition", SAFE, SAFE_BG, fs=9.5)
    arrow(8.2, 4.0, 8.15, 3.55, "yes", lx=0.38, col=SAFE)
    box(3.6, 4.5, 3.6, 1.0, "Read/write columns\ndisjoint?", NODE, "#ffffff", fs=10, bold=True)
    arrow(5.35, 6.08, 4.05, 5.02, "no", lx=-0.55, ly=0.08)
    box(1.95, 2.75, 3.4, 1.55, "G — snapshot gather\nsatisfies condition", COND, COND_BG, fs=9.5)
    arrow(3.15, 4.0, 2.3, 3.55, "yes", lx=-0.3, col=SAFE)
    box(
        5.1,
        0.55,
        7.0,
        1.05,
        "U — theorem inconclusive\nstage, schedule, or analyze separately",
        CERT,
        UNSAFE_BG,
        fs=9.5,
    )
    arrow(2.3, 1.75, 3.7, 1.12, col=CERT)
    arrow(7.9, 1.75, 6.6, 1.1, col=CERT)
    leg = [
        Patch(fc=SAFE_BG, ec=SAFE, label="sufficient condition met"),
        Patch(fc=COND_BG, ec=COND, label="condition shown"),
        Patch(fc=UNSAFE_BG, ec=CERT, label="separate analysis"),
    ]
    ax.legend(handles=leg, loc="upper right", bbox_to_anchor=(1.0, 1.0), fontsize=8)
    save_figure(fig, FIGS / "plot02.png")


# ------------------------------------------------------------------ plot03
def build_plot03():
    d = _load("emergence_threshold_hiN.json")
    taus = np.array(d["taus"])
    c = d["curves"]
    tc = d["tau_c"]
    floor = d["noise_floor_tau"]
    seq_m = tc["sequential"]["median"]

    apply_figure_style()
    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(FULL_W, PANEL_H), gridspec_kw={"width_ratios": [1.35, 1]})

    series = [
        ("sequential_mean", "sequential_sd", SEQ, "o", "Row-wise snapshot"),
        ("staged_mean", "staged_sd", CERT, "s", "Batched GPU snapshot"),
        ("fused_mean", "fused_sd", FREE, "^", "In-place ordered"),
    ]
    for mean_k, sd_k, color, marker, label in series:
        y = np.array(c[mean_k])
        sd = np.array(c[sd_k])
        ax1.plot(taus, y, color=color, marker=marker, markevery=2, label=label, zorder=3)
        ax1.fill_between(taus, y - sd, y + sd, color=color, alpha=0.12, linewidth=0)

    ax1.axhline(0.5, color=MUTED, ls=":", lw=1)
    ax1.axvline(seq_m, color=MUTED, ls=":", lw=0.8, alpha=0.6)
    ax1.set_xlabel(r"per-contact transmissibility $\tau$")
    ax1.set_ylabel("final attack rate")
    ax1.set_xlim(taus[0], taus[-1])
    ax1.set_ylim(0, 1.02)
    ax1.legend(loc="lower right", framealpha=0.95)
    style_axes(ax1)
    panel_label(ax1, "a")

    labels = ["Row-wise\nsnapshot", "Batched GPU\nsnapshot", "In-place\nordered"]
    meds = [tc["sequential"]["median"], tc["staged"]["median"], tc["fused"]["median"]]
    los = [tc["sequential"]["lo"], tc["staged"]["lo"], tc["fused"]["lo"]]
    his = [tc["sequential"]["hi"], tc["staged"]["hi"], tc["fused"]["hi"]]
    colors = [SEQ, CERT, FREE]
    ypos = np.arange(len(labels))
    for i, (m, lo, hi, col) in enumerate(zip(meds, los, his, colors)):
        ax2.errorbar(m, i, xerr=[[m - lo], [hi - m]], fmt="o", color=col, capsize=3, ms=6, lw=1.5)
    ax2.axvspan(seq_m - floor, seq_m + floor, color=MUTED, alpha=0.15, zorder=0)
    ax2.axvline(seq_m, color=MUTED, ls=":", lw=0.8)
    ax2.set_yticks(ypos)
    ax2.set_yticklabels(labels)
    ax2.set_xlabel(r"critical threshold $\tau_c$ (bootstrap median, 95\% CI)")
    ax2.invert_yaxis()
    ax2.text(seq_m + floor + 0.003, 0.5, f"noise floor ±{floor:.4f}", fontsize=7, color=MUTED, va="center")
    style_axes(ax2)
    panel_label(ax2, "b")
    fig.tight_layout(w_pad=1.2)
    save_figure(fig, FIGS / "plot03.png")


# ------------------------------------------------------------------ plot07
def build_plot07():
    d = _load("benchmark_results_all5090.json")
    counts = d["agent_counts"]
    order = [
        "AMBER (GPU)",
        "FLAME GPU 2",
        "AMBER (vectorized)",
        "mesa-frames",
        "AMBER (loop)",
        "Agents.jl",
        "AgentPy",
        "Mesa",
        "Melodie",
        "SimPy",
    ]
    models = ["wealth_transfer", "random_walk", "sir_epidemic"]
    labels = ["Wealth transfer", "Random walk", "SIR epidemic"]
    lookup = {}
    for row in d["results"]:
        lookup[(row["framework"], row["model"], row["n_agents"])] = row["execution_time"]

    apply_figure_style()
    fig, axes = plt.subplots(1, 3, figsize=(FULL_W, 2.8))
    for ax, model, title in zip(axes, models, labels):
        for fw in order:
            xs, ys = [], []
            for n in counts:
                t = lookup.get((fw, model, n))
                if t and t > 0:
                    xs.append(n)
                    ys.append(t)
            if not xs:
                continue
            lw = 2.2 if "AMBER" in fw else 1.3
            ax.plot(
                xs,
                ys,
                marker="o",
                ms=4,
                lw=lw,
                label=fw,
                color=FRAMEWORK_COLORS.get(fw, MUTED),
                alpha=0.95 if "AMBER" in fw else 0.85,
            )
        ax.set_xscale("log")
        ax.set_yscale("log")
        ax.set_xlabel("Agents")
        ax.set_ylabel("Wall time (s)")
        ax.set_title(title, fontsize=9)
        style_axes(ax)
    axes[-1].legend(loc="center left", bbox_to_anchor=(1.02, 0.5), fontsize=6.5)
    fig.tight_layout()
    save_figure(fig, FIGS / "plot07.png")


# ------------------------------------------------------------------ plot08
def build_plot08():
    d = _load("robustness_results.json")
    conf = d["confusion"]
    apply_figure_style()
    fig, ax = plt.subplots(figsize=(FULL_W * 0.55, PANEL_H * 0.9))
    cats = ["TP", "TN", "FP", "FN"]
    vals = [conf["tp"], conf["tn"], conf["fp"], conf["fn"]]
    colors = [SAFE, "#3b82f6", COND, CERT]
    bars = ax.bar(cats, vals, color=colors, edgecolor="white", linewidth=0.8)
    for b, v in zip(bars, vals):
        ax.text(b.get_x() + b.get_width() / 2, v + 4, str(v), ha="center", fontsize=8, fontweight="bold")
    ax.set_ylabel("Rules (of 300)")
    ax.set_ylim(0, max(vals) * 1.15)
    ax.text(
        0.98,
        0.95,
        f"precision {d['precision']:.2f}\nrecall {d['recall']:.2f}\nF1 {d['f1']:.2f}",
        transform=ax.transAxes,
        ha="right",
        va="top",
        fontsize=8,
        bbox=dict(boxstyle="round,pad=0.3", fc="white", ec="#e5e7eb"),
    )
    style_axes(ax)
    save_figure(fig, FIGS / "plot08.png")


# ------------------------------------------------------------------ plot09
def build_plot09():
    d = _load("confluence_results.json")
    apply_figure_style()
    fig, ax = plt.subplots(figsize=(FULL_W * 0.55, PANEL_H * 0.9))
    names, distinct, colors = [], [], []
    for row in d["rows"]:
        short = row["rule"].split("(")[0].strip()
        names.append(short)
        distinct.append(row["distinct"])
        if row["expect"] == "safe":
            colors.append(SAFE if row["confluent"] else CERT)
        else:
            colors.append(CERT if not row["confluent"] else SAFE)
    y = np.arange(len(names))
    ax.barh(y, distinct, color=colors, height=0.55, edgecolor="white")
    ax.set_yticks(y)
    ax.set_yticklabels(names, fontsize=8)
    ax.set_xlabel("Distinct trajectories (sampled orders)")
    ax.set_xscale("log")
    ax.axvline(1, color=MUTED, ls="--", lw=0.8)
    style_axes(ax)
    save_figure(fig, FIGS / "plot09.png")


# ------------------------------------------------------------------ plot10
def build_plot10():
    d = _load("staging_results.json")
    div = d["divergence_by_barriers"]
    apply_figure_style()
    fig, ax = plt.subplots(figsize=(FULL_W * 0.42, PANEL_H * 0.85))
    keys = ["0", "1"]
    vals = [div[k]["mean_divergence"] * 100 for k in keys]
    colors = [CERT, SAFE]
    bars = ax.bar(["0 barriers", "1 barrier"], vals, color=colors, width=0.55, edgecolor="white")
    ax.set_ylabel("Cells diverging from truth (%)")
    ax.set_ylim(0, 55)
    for b, v, k in zip(bars, vals, keys):
        label = f"{v:.0f}%" if k == "0" else "exact"
        ax.text(b.get_x() + b.get_width() / 2, v + 1.5, label, ha="center", fontsize=8, fontweight="bold")
    style_axes(ax)
    save_figure(fig, FIGS / "plot10.png")


# ------------------------------------------------------------------ plot11
def build_plot11():
    rows = _load("barrier_bound.json")
    apply_figure_style()
    fig, ax = plt.subplots(figsize=(FULL_W * 0.7, PANEL_H))
    ell_vals = sorted({r["ell"] for r in rows})
    exact = []
    short = []
    for ell in ell_vals:
        sub = [r for r in rows if r["ell"] == ell]
        exact.append(100 * np.mean([r["full_correct"] for r in sub]))
        short.append(100 * np.mean([r["short_correct"] for r in sub]))
    x = np.arange(len(ell_vals))
    w = 0.35
    ax.bar(x - w / 2, exact, w, label=r"$b=\ell$ (exact)", color=SAFE)
    ax.bar(x + w / 2, short, w, label=r"$b=\ell-1$ (diverges)", color=CERT, alpha=0.85)
    ax.set_xticks(x)
    ax.set_xticklabels([str(e) for e in ell_vals])
    ax.set_xlabel(r"Longest path length $\ell$")
    ax.set_ylabel("Correct cells (%)")
    ax.set_ylim(0, 108)
    ax.legend(loc="lower right", fontsize=8)
    style_axes(ax)
    save_figure(fig, FIGS / "plot11.png")


# ------------------------------------------------------------------ plot12
def build_plot12():
    d = _load("monitor_cost_results.json")
    rows = d["rows"]
    apply_figure_style()
    fig, ax = plt.subplots(figsize=(FULL_W * 0.65, PANEL_H))
    Ns = sorted({r["N"] for r in rows})
    added = [np.mean([r["added_ms"] for r in rows if r["N"] == n]) for n in Ns]
    ax.plot(Ns, added, "o-", color=CERT, lw=2, ms=5, label="Measured added ms/step")
    kappa = d["kappa_ms_per_N"]
    fit = [kappa * n for n in Ns]
    ax.plot(Ns, fit, "--", color=SEQ, lw=1.5, label=rf"linear-in-$N$ fit ($R^2$={d['r2_vs_N']:.3f})")
    ax.set_xscale("log")
    ax.set_xlabel("Population $N$")
    ax.set_ylabel("Added monitor time (ms/step)")
    ax.legend(fontsize=8)
    style_axes(ax)
    save_figure(fig, FIGS / "plot12.png")


# ------------------------------------------------------------------ plot13
def build_plot13():
    d = _load("accuracy_results.json")
    tests = d["tests"]
    apply_figure_style()
    fig, ax = plt.subplots(figsize=(FULL_W * 0.75, PANEL_H * 0.95))
    models = ["wealth_gini", "random_walk_msd", "sir_peak"]
    model_labels = ["Wealth (Gini)", "Random walk", "SIR peak"]
    refs = ["AgentPy", "Mesa", "mesa-frames"]
    x = np.arange(len(refs))
    w = 0.22
    for i, (model, ml) in enumerate(zip(models, model_labels)):
        ps = []
        for ref in refs:
            row = next(t for t in tests if t["model"] == model and ref in t["cmp"])
            ps.append(row["p_value"])
        ax.bar(x + (i - 1) * w, ps, w, label=ml)
    ax.axhline(0.05, color=CERT, ls="--", lw=1, alpha=0.7)
    ax.set_xticks(x)
    ax.set_xticklabels(refs)
    ax.set_ylabel("KS test $p$-value")
    ax.set_ylim(0, 1.05)
    ax.legend(fontsize=7.5, ncol=3, loc="upper center")
    style_axes(ax)
    save_figure(fig, FIGS / "plot13.png")


# ------------------------------------------------------------------ plot14
def build_plot14():
    d = _load("usability_results.json")
    pf = d["per_framework"]
    order = ["AMBER (GPU)", "FLAME GPU 2", "mesa-frames", "AgentPy", "Mesa", "AMBER (vectorized)", "AMBER (loop)"]
    slocs = [pf[k]["mean_sloc"] for k in order if k in pf]
    names = [k.replace("AMBER ", "A.") for k in order if k in pf]
    apply_figure_style()
    fig, ax = plt.subplots(figsize=(FULL_W * 0.7, PANEL_H))
    y = np.arange(len(names))
    colors = [CERT if "A.(GPU)" in n else MUTED for n in names]
    ax.barh(y, slocs, color=colors, height=0.6, edgecolor="white")
    ax.set_yticks(y)
    ax.set_yticklabels(names, fontsize=8)
    ax.set_xlabel("Mean logical SLOC per model")
    ax.invert_yaxis()
    style_axes(ax)
    save_figure(fig, FIGS / "plot14.png")


# ------------------------------------------------------------------ plot15
def build_plot15():
    d = _load("calibration_gpu.json")
    apply_figure_style()
    fig, ax = plt.subplots(figsize=(FULL_W * 0.65, PANEL_H))
    smac = {r["rounds"]: r["mean_l2"] for r in d["methods"]["smac"]}
    rnd = {r["rounds"]: r["mean_l2"] for r in d["methods"]["random"]}
    xs = sorted(smac)
    ax.plot(xs, [smac[x] for x in xs], "o-", color=CERT, label="Batched SMAC", lw=2)
    ax.plot(xs, [rnd[x] for x in xs], "s--", color=MUTED, label="Random search", lw=1.5)
    ax.set_xlabel("Matched evaluation count (×48)")
    ax.set_ylabel(r"Parameter L2 error $(\beta,\gamma)$")
    ax.set_xscale("log", base=2)
    ax.legend(fontsize=8)
    style_axes(ax)
    save_figure(fig, FIGS / "plot15.png")


# ------------------------------------------------------------------ plot17
def build_plot17():
    d = _load("mf_granularity.json")
    taus = np.array(d["taus"])
    blocks = [str(b) for b in d["nblocks"]]
    seq = d["by_nblocks"]["1"]
    seq_curve = np.array(seq["curve"])
    seq_tc = seq["tc"]
    seq_ci = seq["tc_ci"]

    apply_figure_style()
    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(FULL_W, PANEL_H * 1.05), gridspec_kw={"width_ratios": [1.2, 1]})

    cmap = plt.cm.Purples(np.linspace(0.35, 0.9, len(blocks)))
    for i, nb in enumerate(d["nblocks"]):
        curve = np.array(d["by_nblocks"][str(nb)]["curve"])
        tc = d["by_nblocks"][str(nb)]["tc"]
        ax1.plot(taus, curve, color=cmap[i], lw=1.6, label=f"{nb} blocks/step" if nb > 1 else "1 whole-column block")
        ax1.axvline(tc, color=cmap[i], ls=":", lw=0.8, alpha=0.5)
    ax1.fill_between(taus, 0, 1.05, where=(taus >= seq_ci[0]) & (taus <= seq_ci[1]), color=MUTED, alpha=0.1)
    ax1.axvline(seq_tc, color=SEQ, ls="--", lw=1, label="Snapshot reference")
    ax1.set_xlabel(r"$\tau$")
    ax1.set_ylabel("final attack rate")
    ax1.set_xlim(taus[0], taus[-1])
    ax1.set_ylim(0, 1.02)
    ax1.legend(fontsize=6.5, loc="lower right")
    style_axes(ax1)
    panel_label(ax1, "a")

    tcs = [d["by_nblocks"][str(nb)]["tc"] for nb in d["nblocks"]]
    ax2.plot(d["nblocks"], tcs, "o-", color=FREE, lw=2, ms=5)
    ax2.axhline(seq_tc, color=SEQ, ls="--", lw=1)
    ax2.fill_between([0.5, 800], seq_ci[0], seq_ci[1], color=MUTED, alpha=0.12)
    ax2.set_xscale("log")
    ax2.set_xlabel("Blocks per step")
    ax2.set_ylabel(r"Recovered $\tau_c$")
    style_axes(ax2)
    panel_label(ax2, "b")
    fig.tight_layout(w_pad=1.0)
    save_figure(fig, FIGS / "plot17.png")


# ------------------------------------------------------------------ plot18
def build_plot18():
    d = _load("tc_sensitivity.json")
    taus = np.array(d["taus"])
    levels = d["levels"]
    paths = d["paths"]
    apply_figure_style()
    fig, axes = plt.subplots(1, 3, figsize=(FULL_W, PANEL_H * 0.95), sharey=True)
    path_styles = [
        ("sequential", SEQ, "o", "Row-wise snapshot"),
        ("staged", CERT, "s", "Batched GPU snapshot"),
        ("fused", FREE, "^", "In-place ordered"),
    ]
    for ax, lvl, lbl in zip(axes, levels, ["0.3", "0.5", "0.7"]):
        tcs = []
        for key, color, marker, name in path_styles:
            tc = _critical_tau(paths[key]["curve"], taus, thresh=lvl)
            tcs.append(tc)
            ax.scatter([tc], [key], color=color, marker=marker, s=42, zorder=5, label=name)
        ax.set_xlim(min(tcs) - 0.02, max(tcs) + 0.02)
        ax.set_xlabel(r"$\tau_c$ at attack = " + lbl)
        ax.set_yticks([k for k, *_ in path_styles])
        ax.set_yticklabels([name for *_, name in path_styles], fontsize=7.5)
        style_axes(ax)
        panel_label(ax, lbl.replace("0.", ""))
    axes[1].legend(fontsize=7, loc="upper center", ncol=3, bbox_to_anchor=(0.5, 1.28))
    fig.tight_layout()
    save_figure(fig, FIGS / "plot18.png")


# ------------------------------------------------------------------ plot19
def build_plot19():
    rob = _load("robustness_results.json")
    fp = _load("fp_by_class.json")
    stg = _load("staging_results.json")

    apply_figure_style()
    fig, axes = plt.subplots(1, 3, figsize=(FULL_W, PANEL_H * 1.05))

    ax = axes[0]
    recalls = [rob["recall_within_scope"], rob["recall_crossop_only"]]
    labels = ["Commit→borrow", "Borrow→commit"]
    counts = [f"{rob['within_scope_caught']}/{rob['within_scope_total']}", f"{rob['crossop_only_caught']}/{rob['crossop_only_total']}"]
    bars = ax.bar(labels, recalls, color=[SAFE, MUTED], width=0.55, edgecolor="white")
    ax.axhline(1.0, color=MUTED, ls=":", lw=0.8)
    ax.set_ylim(0, 1.08)
    ax.set_ylabel("Detection recall")
    for b, c in zip(bars, counts):
        ax.text(b.get_x() + b.get_width() / 2, b.get_height() + 0.02, c, ha="center", fontsize=7.5, fontweight="bold")
    ax.tick_params(axis="x", labelsize=7.5)
    style_axes(ax)
    panel_label(ax, "a")
    ax.set_title("Generated hazard cases", fontsize=8.5)

    ax = axes[1]
    classes = ["P", "G", "R", r"R$^*$"]
    keys = ["P (pointwise)", "G (gather read-only)", "R (AC reduce)", "R* (non-AC reduce)"]
    rates, fracs = [], []
    for k in keys:
        info = fp["fp_rate_by_class"][k]
        rates.append(100 * info["fp_rate"])
        fracs.append(f"{info['flagged']}/{info['total']}")
    colors = [CERT if r > 0 else SAFE for r in rates]
    bars = ax.bar(classes, rates, color=colors, width=0.55, edgecolor="white")
    ax.set_ylabel("False-positive rate (%)")
    ax.set_ylim(0, 18)
    ax.text(0.02, 0.95, "single-op safe: 0/84", transform=ax.transAxes, fontsize=7, color=SAFE, fontweight="bold")
    for b, f in zip(bars, fracs):
        if b.get_height() > 0:
            ax.text(b.get_x() + b.get_width() / 2, b.get_height() + 0.4, f, ha="center", fontsize=7)
    style_axes(ax)
    panel_label(ax, "b")
    ax.set_title("Conservative reports", fontsize=8.5)

    ax = axes[2]
    div = stg["divergence_by_barriers"]
    vals = [div["0"]["mean_divergence"] * 100, div["1"]["mean_divergence"] * 100]
    bars = ax.bar(["0 barriers", "1 barrier"], vals, color=[CERT, SAFE], width=0.55, edgecolor="white")
    ax.set_ylabel("Cells diverging (%)")
    ax.set_ylim(0, 55)
    ax.text(bars[0].get_x() + 0.275, vals[0] + 1, f"{vals[0]:.0f}%", ha="center", fontsize=8, fontweight="bold")
    ax.text(bars[1].get_x() + 0.275, 2, "exact", ha="center", fontsize=8, fontweight="bold", color=SAFE)
    style_axes(ax)
    panel_label(ax, "c")
    ax.set_title("Double-buffer construction", fontsize=8.5)
    fig.tight_layout(w_pad=1.0)
    save_figure(fig, FIGS / "plot19.png")


# ------------------------------------------------------------------ plot21
def build_plot21():
    sci = _load("emergence_science_ext.json")
    shell = _load("schelling_gpu.json")
    coord = _load("coordination_gpu.json")
    radii = np.array(sci["radii"])
    taus_s = np.array(shell["taus"])
    eps = np.array(coord["eps"])

    apply_figure_style()
    fig, axes = plt.subplots(1, 3, figsize=(FULL_W, PANEL_H * 1.05))

    ax = axes[0]
    ax.errorbar(
        radii,
        sci["tc_staged"],
        yerr=[np.array(sci["tc_staged"]) - np.array(sci["boot_staged"]["tc_lo"]),
              np.array(sci["boot_staged"]["tc_hi"]) - np.array(sci["tc_staged"])],
        fmt="o-",
        color=CERT,
        capsize=2,
        lw=1.8,
        label="Snapshot/staged",
    )
    ax.errorbar(
        radii,
        sci["tc_fused"],
        yerr=[np.array(sci["tc_fused"]) - np.array(sci["boot_fused"]["tc_lo"]),
              np.array(sci["boot_fused"]["tc_hi"]) - np.array(sci["tc_fused"])],
        fmt="s--",
        color=FREE,
        capsize=2,
        lw=1.5,
        label="In-place ordered",
    )
    ax.set_xscale("log")
    ax.set_xticks([2, 4, 8, 12])
    ax.set_xticklabels(["2", "4", "8", "12"])
    ax.minorticks_off()
    ax.set_xlabel(r"Contact radius $r$")
    ax.set_ylabel(r"$\tau_c$")
    ax.legend(fontsize=7.5)
    txt = rf"slope: {sci['boot_staged']['slope_med']:.2f} vs {sci['boot_fused']['slope_med']:.2f}"
    ax.text(0.03, 0.05, txt, transform=ax.transAxes, fontsize=7, color=MUTED)
    style_axes(ax)
    panel_label(ax, "a")

    ax = axes[1]
    ax.plot(taus_s, shell["S_cert"], "o-", color=CERT, lw=1.8, label="Snapshot/staged")
    ax.plot(taus_s, shell["S_free"], "s--", color=FREE, lw=1.5, label="In-place ordered")
    ax.set_xlabel(r"Tolerance $\tau$")
    ax.set_ylabel("Segregation index $S$")
    ax.set_ylim(0.5, 1.02)
    ax.legend(fontsize=7.5, loc="lower right")
    style_axes(ax)
    panel_label(ax, "b")

    ax = axes[2]
    ax.plot(eps, coord["consensus_cert"], "o-", color=CERT, lw=1.8, label="Snapshot/staged (N=20k)")
    ax.plot(eps, coord["consensus_free"], "s--", color=FREE, lw=1.5, label="In-place ordered (N=2k)")
    ax.set_xlabel(r"Confidence bound $\varepsilon$")
    ax.set_ylabel("Largest cluster fraction")
    ax.set_ylim(0.85, 1.02)
    ax.legend(fontsize=7.5)
    style_axes(ax)
    panel_label(ax, "c")
    fig.tight_layout(w_pad=1.0)
    save_figure(fig, FIGS / "plot21.png")


BUILDERS = {
    "plot01": build_plot01,
    "plot02": build_plot02,
    "plot03": build_plot03,
    "plot07": build_plot07,
    "plot08": build_plot08,
    "plot09": build_plot09,
    "plot10": build_plot10,
    "plot11": build_plot11,
    "plot12": build_plot12,
    "plot13": build_plot13,
    "plot14": build_plot14,
    "plot15": build_plot15,
    "plot17": build_plot17,
    "plot18": build_plot18,
    "plot19": build_plot19,
    "plot21": build_plot21,
}


def main():
    apply_figure_style()
    for name, fn in BUILDERS.items():
        print(f"  {name}...", flush=True)
        fn()
    print(f"Done — {len(BUILDERS)} figures -> {FIGS}")


if __name__ == "__main__":
    main()
