# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / Packaging
dist/
build/
*.egg-info/
.eggs/
*.whl
*.tar.gz

# Environments
.env
.venv
env/
venv/
ENV/

# Jupyter
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# IDE / assistants
.vscode/
.idea/
.claude/
*.swp
.DS_Store

# Testing / coverage / type / lint caches
.coverage
.coverage.*
.!*.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
coverage.xml
.tox/
.nox/

# Documentation builds (hand-written docs/api/*.rst stay tracked)
docs/_build/

# Manuscript drafts / LaTeX build artifacts — cite the public paper; do not commit drafts
paper/
paper.*
paper.zip

# SMAC / optimizer run output
smac3_output/
smac3-output*/
**/runhistory.json
**/scenario.txt

# Benchmark raw timings / machine-local reruns (regenerate; keep committed charts/md only)
benchmarks/results/*.json
benchmarks/results/*.log
# Tagged host reruns (e.g. RTX 5090 interim splits) — not source of truth for the README
benchmarks/results/*5090*
benchmarks/results/_native_pull/
benchmarks/results/summary_table_amber_*.md
benchmarks/results/scaling_chart_amber_*.png
benchmarks/results/amber_*.log
# Authoritative README headline (AMBER GPU vs FLAME @ 10M, 10-run, all samples)
!benchmarks/results/benchmark_results_snapshot_correct_10run_10m.json
!benchmarks/results/summary_table_snapshot_correct_10run_10m.md

# Local release notes / scratch (never ship)
PR_DESCRIPTIONS.md
*.local.md

# Paper / AAMAS island — lives OUTSIDE this repo (e.g. ~/Documents/AMBER_AAMAS).
# Never re-introduce paper materials into the library package.
paper-fix-work/
AMBER_AAMAS/

# Local campaign / machine scratch (not package surface)
artifacts/host_*/
artifacts/**/cupy_cache/
tmp/
tools/**/*.log
