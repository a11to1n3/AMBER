# Unified Host-B (RTX 5090) campaign configuration
# Copy to host_b_campaign.env and edit.

export AMBER_REPO="${AMBER_REPO:-/workspace/AMBER_aamas_exp}"
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"
export CUDA_PATH="${CUDA_PATH:-/usr/local/cuda-12.9}"
export PATH="$CUDA_PATH/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_PATH/lib64:${LD_LIBRARY_PATH:-}"
# pyflamegpu+cuda130 needs libnvrtc.so.13 (pip: nvidia-cuda-nvrtc / nvidia-nvjitlink)
if [[ -n "${VIRTUAL_ENV:-}" ]]; then
  for d in "${VIRTUAL_ENV}"/lib/python*/site-packages/nvidia/cu13/lib \
           "${VIRTUAL_ENV}"/lib/python*/site-packages/nvidia/nvjitlink/lib \
           "${VIRTUAL_ENV}"/lib/python*/site-packages/nvidia/cuda_nvrtc/lib; do
    [[ -d "$d" ]] && export LD_LIBRARY_PATH="$d:${LD_LIBRARY_PATH}"
  done
fi
export PYTHONHASHSEED=0
export AMBER_SUPPRESS_DEPRECATIONS=1
export FLAMEGPU_TELEMETRY_SUPPRESS_NOTICE=1
export FLAMEGPU_SHARE_USAGE_STATISTICS=False

# Filled by freeze / orchestrator if empty
export AMBER_COMMIT="${AMBER_COMMIT:-}"
export CAMPAIGN_TAG="${CAMPAIGN_TAG:-}"
export ARTIFACT_ROOT="${ARTIFACT_ROOT:-}"

export PYTHONPATH="${AMBER_REPO}/src:${AMBER_REPO}"
export CUPY_CACHE_DIR="${ARTIFACT_ROOT:-/tmp}/00_environment/cupy_cache"

# Experiment commands (invoked from AMBER_REPO with venv active)
CMD_RNG="python experiments/rng/counter_rng.py && python tools/host_b_rerun/run_rng_matrix.py"
CMD_CONFORMANCE_GPU_STYLE="python experiments/semantic/run_attestation.py --tag host_b --out \$ARTIFACT_ROOT/03_conformance_gpu_style"
CMD_CONFORMANCE_NATIVE="python experiments/semantic/run_production_attestation.py --tag host_b --out \$ARTIFACT_ROOT/04_conformance_native"
CMD_MONITOR_BOUNDARY="python experiments/monitor/run_boundary_matrix.py --tag host_b --out \$ARTIFACT_ROOT/05_monitor"
CMD_MONITOR_OVERHEAD="python experiments/monitor/run_overhead.py --tag host_b --out \$ARTIFACT_ROOT/05_monitor"
CMD_ACTIVATION_SIR_SURFACE="python experiments/benchmarks/run_activation.py --tag host_b --out \$ARTIFACT_ROOT/06_activation"
CMD_ACTIVATION_SIR_CROSSING="python experiments/benchmarks/run_sir_crossing.py --tag host_b --out \$ARTIFACT_ROOT/06_activation"
CMD_PERFORMANCE_CROSSOVER="python experiments/benchmarks/run_performance.py --tag host_b --out \$ARTIFACT_ROOT/07_performance --skip-matched"
CMD_PERFORMANCE_ALL="python benchmarks/run_all_frameworks.py --agents 1000 10000 100000 1000000 10000000 --steps 50 --runs 10 --budget 300 --tag \${CAMPAIGN_TAG}_unified"
CMD_PERFORMANCE_10M="python benchmarks/run_all_frameworks.py --agents 10000000 --steps 50 --runs 10 --budget 1200 --frameworks \"AMBER (GPU)\" \"FLAME GPU 2\" --models wealth_transfer random_walk sir_epidemic schelling --tag \${CAMPAIGN_TAG}_10m"
CMD_VALIDATE="python tools/host_b_rerun/validate_host_b_campaign.py \$ARTIFACT_ROOT"
